{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-atlas.example/schemas/instrumented-transition-conformance.v1.json",
  "title": "Instrumented transition, traversal, survivability, and evidence-economy fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile", "state_model", "instrument_profiles",
    "measurement_map", "resource_priority", "instrument_cases",
    "survivability_cases", "economy_cases"
  ],
  "properties": {
    "schema_version": { "const": "instrumented-transition-conformance.v1" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "subject_type", "policy_id", "policy_generation"],
      "properties": {
        "subject_id": { "$ref": "#/$defs/id" },
        "subject_type": { "$ref": "#/$defs/id" },
        "policy_id": { "$ref": "#/$defs/id" },
        "policy_generation": { "type": "integer", "minimum": 1 }
      }
    },
    "state_model": { "$ref": "#/$defs/stateModel" },
    "instrument_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://delta-atlas.example/schemas/instrument-profile.v1.json" }
    },
    "measurement_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument_id", "check_ids"],
        "properties": {
          "instrument_id": { "$ref": "#/$defs/id" },
          "check_ids": { "$ref": "#/$defs/idSet" }
        }
      }
    },
    "resource_priority": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["irreversibility", "egress_bytes", "invasiveness", "external_tool_calls", "local_tool_calls", "bytes_read", "token_ceiling", "wall_time_ms"] }
    },
    "instrument_cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/instrumentCase" } },
    "survivability_cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/survivabilityCase" } },
    "economy_cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/economyCase" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "idSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "status": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
    "reason": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["irreversibility", "invasiveness", "external_tool_calls", "local_tool_calls", "bytes_read", "egress_bytes", "token_ceiling", "wall_time_ms"],
      "properties": {
        "irreversibility": { "type": "integer", "minimum": 0, "maximum": 3 },
        "invasiveness": { "type": "integer", "minimum": 0, "maximum": 3 },
        "external_tool_calls": { "type": "integer", "minimum": 0 },
        "local_tool_calls": { "type": "integer", "minimum": 0 },
        "bytes_read": { "type": "integer", "minimum": 0 },
        "egress_bytes": { "type": "integer", "minimum": 0 },
        "token_ceiling": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "legal", "safe", "essential"],
      "properties": {
        "state_id": { "$ref": "#/$defs/id" },
        "legal": { "type": "boolean" },
        "safe": { "type": "boolean" },
        "essential": { "type": "boolean" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "from", "to", "kind"],
      "properties": {
        "transition_id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["CONTROL", "DISTURBANCE", "INSTRUMENT"] },
        "instrument_id": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "INSTRUMENT" } }, "required": ["kind"] },
          "then": { "required": ["instrument_id"] },
          "else": { "not": { "required": ["instrument_id"] } }
        }
      ]
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "transitions"],
      "properties": {
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/state" } },
        "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "reason_code": { "$ref": "#/$defs/reason" },
        "final_state": { "$ref": "#/$defs/id" },
        "selected_instrument_id": { "type": ["string", "null"] }
      }
    },
    "instrumentCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "initial_state", "events", "expected"],
      "properties": {
        "case_id": { "$ref": "#/$defs/caseId" },
        "initial_state": { "$ref": "#/$defs/id" },
        "events": { "type": "array", "minItems": 1, "items": { "$ref": "https://delta-atlas.example/schemas/instrument-event.v1.json" } },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "traversalLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_states", "max_transitions", "max_depth"],
      "properties": {
        "max_states": { "type": "integer", "minimum": 1 },
        "max_transitions": { "type": "integer", "minimum": 1 },
        "max_depth": { "type": "integer", "minimum": 1 }
      }
    },
    "survivabilityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "initial_state", "horizon", "recovery_target_states", "disturbance_transition_ids", "controller", "traversal_limits", "expected"],
      "properties": {
        "case_id": { "$ref": "#/$defs/caseId" },
        "initial_state": { "$ref": "#/$defs/id" },
        "horizon": { "type": "integer", "minimum": 1 },
        "recovery_target_states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "disturbance_transition_ids": { "$ref": "#/$defs/idSet" },
        "controller": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state_id", "transition_id"],
            "properties": {
              "state_id": { "$ref": "#/$defs/id" },
              "transition_id": { "$ref": "#/$defs/id" }
            }
          }
        },
        "traversal_limits": { "$ref": "#/$defs/traversalLimits" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "result", "fresh"],
      "properties": {
        "check_id": { "$ref": "#/$defs/id" },
        "result": { "enum": ["PASS", "FAIL", "UNKNOWN", "STALE", "ERROR"] },
        "fresh": { "type": "boolean" }
      }
    },
    "economyCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "required_check_id", "current_evidence", "initial_state", "candidate_instrument_ids", "authorized_consequence_classes", "instrument_assessments", "budget", "expected"],
      "properties": {
        "case_id": { "$ref": "#/$defs/caseId" },
        "required_check_id": { "$ref": "#/$defs/id" },
        "current_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "initial_state": { "$ref": "#/$defs/id" },
        "candidate_instrument_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "authorized_consequence_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["READ_ONLY", "REVERSIBLE", "COMPENSATABLE", "IRREVERSIBLE"] } },
        "instrument_assessments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instrument_id", "guard_status", "authority_status", "observability_status", "recoverability_status", "evidence_refs"],
            "properties": {
              "instrument_id": { "$ref": "#/$defs/id" },
              "guard_status": { "$ref": "#/$defs/obligationStatus" },
              "authority_status": { "$ref": "#/$defs/obligationStatus" },
              "observability_status": { "$ref": "#/$defs/obligationStatus" },
              "recoverability_status": { "$ref": "#/$defs/obligationStatus" },
              "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
            }
          }
        },
        "budget": { "$ref": "#/$defs/resources" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "obligationStatus": { "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_REQUIRED"] }
  }
}
