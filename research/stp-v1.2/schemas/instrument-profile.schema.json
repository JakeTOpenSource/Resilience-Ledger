{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-atlas.example/schemas/instrument-profile.v1.json",
  "title": "Typed intervention instrument profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "instrument_id", "instrument_version", "subject_type",
    "allowed_states", "input_schema_ref", "state_read_set", "state_write_set",
    "effect_footprint", "sensing_effect_footprint", "consequence_class",
    "authority_required", "measurement", "resource_bound", "privacy"
  ],
  "properties": {
    "schema_version": { "const": "instrument-profile.v1" },
    "instrument_id": { "type": "string", "pattern": "^urn:delta-atlas:instrument:[a-z0-9][a-z0-9._-]*$" },
    "instrument_version": { "type": "integer", "minimum": 1 },
    "subject_type": { "type": "string", "minLength": 1 },
    "allowed_states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "input_schema_ref": { "type": "string", "format": "uri" },
    "state_read_set": { "$ref": "#/$defs/stringSet" },
    "state_write_set": { "$ref": "#/$defs/stringSet" },
    "effect_footprint": { "$ref": "#/$defs/stringSet" },
    "sensing_effect_footprint": { "$ref": "#/$defs/stringSet" },
    "consequence_class": { "enum": ["READ_ONLY", "REVERSIBLE", "COMPENSATABLE", "IRREVERSIBLE"] },
    "authority_required": { "type": "boolean" },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedure_ref", "measurand_id", "result_schema_ref", "unit",
        "resolution", "dead_band", "detection_limit", "response_window_steps",
        "operating_conditions", "calibration_ref", "domain_null_allowed"
      ],
      "properties": {
        "procedure_ref": { "type": "string", "format": "uri" },
        "measurand_id": { "type": "string", "minLength": 1 },
        "result_schema_ref": { "type": "string", "format": "uri" },
        "unit": { "type": "string", "minLength": 1 },
        "resolution": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "dead_band": { "type": ["number", "null"], "minimum": 0 },
        "detection_limit": { "type": ["number", "null"] },
        "response_window_steps": { "type": "integer", "minimum": 1 },
        "operating_conditions": { "$ref": "#/$defs/stringSet" },
        "calibration_ref": { "type": "string", "minLength": 1 },
        "domain_null_allowed": { "type": "boolean" }
      }
    },
    "resource_bound": { "$ref": "#/$defs/resources" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_class", "egress_allowed", "max_egress_bytes"],
      "properties": {
        "access_class": { "enum": ["PUBLIC", "COLLABORATOR_RESTRICTED", "OWNER_PRIVATE"] },
        "egress_allowed": { "type": "boolean" },
        "max_egress_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["irreversibility", "invasiveness", "external_tool_calls", "local_tool_calls", "bytes_read", "egress_bytes", "token_ceiling", "wall_time_ms"],
      "properties": {
        "irreversibility": { "type": "integer", "minimum": 0, "maximum": 3 },
        "invasiveness": { "type": "integer", "minimum": 0, "maximum": 3 },
        "external_tool_calls": { "type": "integer", "minimum": 0 },
        "local_tool_calls": { "type": "integer", "minimum": 0 },
        "bytes_read": { "type": "integer", "minimum": 0 },
        "egress_bytes": { "type": "integer", "minimum": 0 },
        "token_ceiling": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
