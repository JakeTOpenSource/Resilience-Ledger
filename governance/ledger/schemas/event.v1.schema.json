{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience-eval-ai.pages.dev/governance/ledger/schemas/event.v1.schema.json",
  "title": "Delta Atlas governance event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "stream_id",
    "sequence",
    "event_type",
    "occurred_at",
    "recorded_at",
    "actor",
    "classification",
    "consequence_class",
    "parents",
    "prev_event_hash",
    "payload_hash",
    "event_hash",
    "read_set",
    "write_set",
    "precondition_refs",
    "evidence_refs",
    "authority_ref",
    "idempotency_key",
    "decision",
    "status_axes",
    "effect",
    "supersedes",
    "correction_of",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_id": { "type": "string", "pattern": "^evt_[a-z0-9][a-z0-9_-]+$" },
    "stream_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]+(\\.[a-z][a-z0-9_]+)+$" },
    "occurred_at": { "type": ["string", "null"], "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "auth_basis"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "auth_basis": { "type": "string", "minLength": 1 }
      }
    },
    "classification": { "enum": ["PUBLIC", "INTERNAL", "RESTRICTED"] },
    "consequence_class": { "enum": ["C0", "C1", "C2", "C3"] },
    "parents": { "$ref": "#/$defs/eventIds" },
    "prev_event_hash": { "$ref": "#/$defs/hashOrEmpty" },
    "payload_hash": { "$ref": "#/$defs/hash" },
    "event_hash": { "$ref": "#/$defs/hash" },
    "read_set": { "$ref": "#/$defs/stringArray" },
    "write_set": { "$ref": "#/$defs/stringArray" },
    "precondition_refs": { "$ref": "#/$defs/stringArray" },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_id", "kind", "classification", "sha256", "source_locator"],
        "properties": {
          "ref_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["PUBLIC", "INTERNAL", "RESTRICTED"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "source_locator": { "type": ["string", "null"] }
        }
      }
    },
    "authority_ref": { "type": ["string", "null"] },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["OBSERVE", "ACCEPT", "ACCEPT_WITH_LIMITS", "DEFER", "REJECT", "SUPERSEDE", "CORRECT"] },
    "status_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "authority", "preparation", "execution", "observation", "acceptance", "outcome"],
      "properties": {
        "evidence": { "enum": ["VERIFIED", "UNVERIFIED", "NOT_OBSERVED", "NOT_APPLICABLE"] },
        "authority": { "enum": ["AUTHORIZED", "UNVERIFIED", "NOT_REQUIRED", "NOT_OBSERVED"] },
        "preparation": { "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"] },
        "execution": { "enum": ["PASS", "FAIL", "NOT_EXECUTED", "UNKNOWN", "NOT_APPLICABLE"] },
        "observation": { "enum": ["OBSERVED", "FAIL", "NOT_OBSERVED", "UNKNOWN", "NOT_APPLICABLE"] },
        "acceptance": { "enum": ["ACCEPT", "ACCEPT_WITH_LIMITS", "DEFER", "REJECT", "NOT_APPLICABLE"] },
        "outcome": { "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_OBSERVED", "NOT_APPLICABLE"] }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "reversible", "recovery_ref"],
      "properties": {
        "kind": { "enum": ["NONE", "REPOSITORY_CHANGE", "DEPLOYMENT", "EXTERNAL_MESSAGE", "DELETION"] },
        "target": { "type": ["string", "null"] },
        "reversible": { "type": "boolean" },
        "recovery_ref": { "type": ["string", "null"] }
      }
    },
    "supersedes": { "$ref": "#/$defs/eventIds" },
    "correction_of": { "$ref": "#/$defs/eventIds" },
    "payload": { "type": "object" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hashOrEmpty": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
    "stringArray": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "eventIds": { "type": "array", "items": { "type": "string", "pattern": "^evt_[a-z0-9][a-z0-9_-]+$" }, "uniqueItems": true }
  }
}
